    "website_url": "https://github.com/yechuri-github64/cbom-netscan",
    "capabilities": [
      "CBOM"
    ],
    "availability": [
      "OPEN_SOURCE",
      "OSI_APPROVED"
    ],
    "functions": [
      "ANALYSIS"
    ],
    "packaging": [
      "COMMAND_LINE_UTILITY"
    ],
    "library": [
      "GO"
    ],
    "platform": [
      "LINUX",
      "MAC",
      "WINDOWS"
    ],
    "lifecycle": [
      "OPERATIONS"
    ],
    "supportedStandards": [
      "CYCLONEDX"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.6"
    ]
  }
}
